# ============================================================
# Root .env.example — for Docker Compose
# ============================================================
# Copy this file to .env and replace every placeholder before running:
#   cp .env.example .env
#   docker compose up
#
# Never commit real credentials. Store production values in GitHub Actions
# secrets and deployment-provider environment settings.

# Supabase — shared by the backend and frontend
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# Frontend build variables
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_API_URL=http://localhost:8000

# Google Gemini
GEMINI_API_KEY=your-gemini-api-key

# Backend CORS
CORS_ORIGINS=http://localhost:80,http://localhost:3000
