# ============================================================
# Unified Dockerfile — AI Reskilling Platform
# ============================================================
# This builds the React frontend and Python backend into a single image.
#
# Build: docker build -t reskilling-platform-full -f Dockerfile.unified .
# Run:   docker run -p 8000:8000 --env-file .env reskilling-platform-full
# ============================================================

# ── Stage 1: Build the React application ────────────────────
FROM node:20-alpine AS frontend-builder
WORKDIR /app
COPY CareerDev/package.json CareerDev/package-lock.json ./
RUN npm install --prefer-offline --no-audit --no-fund
COPY CareerDev/ .

# Build args
ARG VITE_SUPABASE_URL
ARG VITE_SUPABASE_ANON_KEY
# Use an empty API URL so the frontend uses relative paths (hits the same server)
ENV VITE_SUPABASE_URL=$VITE_SUPABASE_URL
ENV VITE_SUPABASE_ANON_KEY=$VITE_SUPABASE_ANON_KEY
ENV VITE_API_URL=""

RUN npm run build

# ── Stage 2: Build the FastAPI backend & serve ──────────────
FROM python:3.11-slim
WORKDIR /app

# Install system build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*
RUN pip install --upgrade pip

# Install Python dependencies
COPY reskilling-platform/pyproject.toml .
RUN pip install --retries 5 --timeout 60 \
    "fastapi>=0.111" \
    "uvicorn[standard]>=0.30" \
    "spacy>=3.7" \
    "pandas>=2.2" \
    "scikit-learn>=1.4" \
    "python-dotenv>=1.0" \
    "requests>=2.31" \
    "sqlalchemy>=2.0" \
    "psycopg2-binary>=2.9" \
    "pyjwt>=2.9" \
    "google-genai>=0.3" \
    "streamlit>=1.35"

# Download spaCy NLP model
RUN python -m spacy download en_core_web_md

# Copy source code and install the package
COPY reskilling-platform/ .
RUN pip install --no-deps -e .

# Copy built frontend assets from Stage 1 into the "static" directory
COPY --from=frontend-builder /app/dist ./static

# Security — run as non-root user
RUN useradd --create-home --shell /bin/bash appuser \
    && chown -R appuser:appuser /app
USER appuser

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')"

CMD ["uvicorn", "app_api.main:app", \
     "--host", "0.0.0.0", \
     "--port", "8000", \
     "--workers", "1", \
     "--log-level", "info"]
